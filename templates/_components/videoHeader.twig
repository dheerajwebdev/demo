{#
  Video Header
  Content Block field: entry.videoHeader
    - headerContent (CKEditor) : heading ("Heading" style) + intro paragraph(s)
    - video         (Asset)    : uploaded video; falls back to web/static/video/BP_Captial_Final.mp4
    - posterImage   (Asset)    : poster / static fallback; falls back to web/static/img/video-poster.jpg

  Behaviour:
    - Desktop/tablet on a decent connection: autoplays muted, loops, plays inline.
    - Phones (< 768px), Save-Data, 2G/3G, or prefers-reduced-motion: shows the static poster only
      (the video file is never requested).
    - No JS: static poster.
#}

{% set videoHeader = videoHeader ?? entry.videoHeader ?? null %}

{% if videoHeader %}
  {% set headerContent = videoHeader.headerContent ?? null %}
  {% set hasContent = headerContent and (headerContent|striptags|trim|length > 0) %}

  {% set video = videoHeader.video.one() ?? null %}
  {% set videoSrc = video ? video.url : url('static/video/BP_Captial_Final.mp4') %}

  {% set poster = videoHeader.posterImage.one() ?? null %}
  {% set posterUrl = poster
    ? poster.getUrl({ width: 1280, height: 720, mode: 'crop', quality: 85, format: 'jpg' })
    : url('static/img/video-poster.jpg') %}
  {% set videoLabel = video.title ?? 'BP Capital video' %}

  {# Stats band shown under the video. Each label line is rendered on its own line. #}
  {% set stats = [
    { value: '20+',    label: ['Control Oriented', 'Investments'] },
    { value: '35+',    label: ['Transactions', 'Since Inception'] },
    { value: '$1.1bn', label: ['Capital Returned', 'to Investors'] },
  ] %}
  {# Optional photo behind the stats, e.g. 'static/img/stats-bg.jpg'. Leave null for the navy gradient. #}
  {% set statsBackground = null %}

  {# Component styles live here so they work without rebuilding the Tailwind bundle #}
  {% css %}
    .video-header { padding-top: 128px; padding-bottom: 56px; border-bottom: 1px solid rgb(255 255 255 / .2); }
    @media (min-width: 1024px) { .video-header { padding-top: 176px; padding-bottom: 64px; } }
    @media (min-width: 1200px) { .video-header { padding-top: 190px; } }

    .video-header__copy { font-size: 1.125rem; line-height: 1.6; }
    .video-header__copy h1, .video-header__copy h2, .video-header__copy h3 {
      font-family: Castoro, ui-serif, Georgia, serif; font-size: 2.5rem; line-height: 1.12; margin-bottom: 1.75rem;
    }
    .video-header__copy p:not(:last-child) { margin-bottom: 1rem; }
    .video-header__copy a { text-decoration: underline; }
    .video-header__copy strong { font-weight: 700; }
    @media (min-width: 1024px) {
      .video-header__copy { font-size: 1.5rem; line-height: 1.45; }
      .video-header__copy h1, .video-header__copy h2, .video-header__copy h3 { font-size: 3.375rem; }
    }
    @media (min-width: 1400px) {
      .video-header__copy h1, .video-header__copy h2, .video-header__copy h3 { font-size: 3.625rem; }
    }

    .video-header__frame {
      position: relative; overflow: hidden; aspect-ratio: 16 / 9;
      border: 2px solid #fff; border-radius: 10px; background: #e8edf3;
      box-shadow: 0 25px 50px -12px rgb(0 0 0 / .45);
      isolation: isolate; /* keeps the rounded clip on the video in Safari */
    }
    .video-header__frame img,
    .video-header__frame video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
    .video-header__frame video { opacity: 0; transition: opacity .6s ease; }
    .video-header__frame video.is-playing { opacity: 1; }

    .video-stats {
      position: relative; overflow: hidden; color: #fff;
      background:
        radial-gradient(90% 140% at 50% -30%, rgb(44 130 233 / .30) 0%, rgb(44 130 233 / 0) 60%),
        linear-gradient(135deg, #34417a 0%, #1c2856 45%, #0c1738 100%);
      padding: 56px 0;
    }
    @media (min-width: 1024px) { .video-stats { padding: 56px 0 60px; } }
    .video-stats__bg { position: absolute; inset: 0; z-index: 0; }
    .video-stats__bg img { width: 100%; height: 100%; object-fit: cover; object-position: center 65%; }
    .video-stats__bg::after {
      content: ''; position: absolute; inset: 0;
      background: linear-gradient(180deg, rgb(43 55 98 / .82) 0%, rgb(20 32 70 / .9) 100%);
    }
    .video-stats__list {
      position: relative; z-index: 1;
      display: grid; grid-template-columns: 1fr; gap: 44px; text-align: center;
    }
    @media (min-width: 768px) { .video-stats__list { grid-template-columns: repeat(3, 1fr); gap: 32px; } }
    .video-stats__item { position: relative; display: flex; flex-direction: column-reverse; }

    /* Dividers between stats: short horizontal lines when stacked, vertical lines in a row */
    .video-stats__item + .video-stats__item::before {
      content: ''; position: absolute; left: 50%; top: -22px; /* half of the 44px gap */
      width: 64px; height: 1px; transform: translateX(-50%);
      background: linear-gradient(90deg, rgb(255 255 255 / 0), rgb(255 255 255 / .45), rgb(255 255 255 / 0));
    }
    @media (min-width: 768px) {
      .video-stats__item + .video-stats__item::before {
        left: -16px; top: 6%; bottom: 6%; /* half of the 32px gap */
        width: 1px; height: auto; transform: none;
        background: linear-gradient(180deg, rgb(255 255 255 / 0), rgb(255 255 255 / .45) 25%, rgb(255 255 255 / .45) 75%, rgb(255 255 255 / 0));
      }
    }
    .video-stats__value {
      display: block; font-family: Castoro, ui-serif, Georgia, serif;
      font-size: 3rem; line-height: 1; letter-spacing: -.01em;
    }
    .video-stats__label {
      display: block; margin-top: 12px; color: #8fc3ee;
      text-transform: uppercase; letter-spacing: .08em;
      font-size: .875rem; line-height: 1.5;
    }
    @media (min-width: 1024px) {
      .video-stats__value { font-size: 4.25rem; }
      .video-stats__label { font-size: 1.0625rem; margin-top: 14px; }
    }
  {% endcss %}

  <section class="video-header bg-blue-200 text-white">
    <div class="container">
      <div class="layout-grid gap-y-10 items-center">

        {% if hasContent %}
          <div class="video-header__copy font-serif col-span-full lg:col-span-6">
            {{ headerContent }}
          </div>
        {% endif %}

        <div class="col-span-full {{ hasContent ? 'lg:col-span-6' }}">
          <div
            class="video-header__frame"
            x-data="{
              useVideo: false,
              playing: false,
              init() {
                const conn = navigator.connection || {};
                const slow = conn.saveData || /(^|slow-)2g|3g/.test(conn.effectiveType || '');
                const small = window.matchMedia('(max-width: 767px)').matches;
                const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                if (slow || small || reduced) return;
                this.useVideo = true;
                this.$nextTick(() => {
                  const v = this.$refs.video;
                  if (!v) return;
                  v.muted = true; // must be set as a property for autoplay to be allowed
                  v.play().catch(() => {});
                });
              }
            }"
          >
            {# Static fallback (phones, slow connections, reduced motion, no JS) and loading state #}
            <img src="{{ posterUrl }}" alt="{{ videoLabel }}" width="1280" height="720" fetchpriority="high">

            <template x-if="useVideo">
              <video
                x-ref="video"
                x-bind:class="{ 'is-playing': playing }"
                x-on:playing="playing = true"
                src="{{ videoSrc }}"
                poster="{{ posterUrl }}"
                muted autoplay loop playsinline
                preload="auto"
                disablepictureinpicture
                aria-label="{{ videoLabel }}"
              ></video>
            </template>
          </div>
        </div>

      </div>
    </div>
  </section>

  {% if stats|length %}
    <section class="video-stats" aria-label="BP Capital at a glance">
      {% if statsBackground %}
        <div class="video-stats__bg" aria-hidden="true">
          <img src="{{ url(statsBackground) }}" alt="" loading="lazy">
        </div>
      {% endif %}
      <div class="container">
        <dl class="video-stats__list">
          {% for stat in stats %}
            <div class="video-stats__item">
              <dt class="video-stats__label">
                {% for line in stat.label %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}
              </dt>
              <dd class="video-stats__value">{{ stat.value }}</dd>
            </div>
          {% endfor %}
        </dl>
      </div>
    </section>
  {% endif %}
{% endif %}
