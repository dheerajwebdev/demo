{#
  Video Header
  Content Block field: entry.videoHeader
    - headerContent (CKEditor) : heading ("Heading" style) + intro paragraph(s)
    - video         (Asset)    : uploaded video; falls back to web/static/video/BP_Captial_Final.mp4
    - posterImage   (Asset)    : poster / static fallback; falls back to web/static/img/video-poster.jpg

  Behaviour:
    - Desktop/tablet on a decent connection: autoplays muted, loops, plays inline.
    - Phones (< 768px), Save-Data, 2G/3G, or prefers-reduced-motion: shows the static poster only
      (the video file is never requested).
    - No JS: static poster.
#}

{% set videoHeader = videoHeader ?? entry.videoHeader ?? null %}

{% if videoHeader %}
  {% set headerContent = videoHeader.headerContent ?? null %}
  {% set hasContent = headerContent and (headerContent|striptags|trim|length > 0) %}

  {% set video = videoHeader.video.one() ?? null %}
  {% set videoSrc = video ? video.url : url('static/video/BP_Captial_Final.mp4') %}

  {% set poster = videoHeader.posterImage.one() ?? null %}
  {% set posterUrl = poster
    ? poster.getUrl({ width: 1280, height: 720, mode: 'crop', quality: 85, format: 'jpg' })
    : url('static/img/video-poster.jpg') %}
  {% set videoLabel = video.title ?? 'BP Capital video' %}

  {# Stats band shown under the video. Each label line is rendered on its own line. #}
  {% set stats = [
    { value: '20+',    label: ['Control Oriented', 'Investments'] },
    { value: '35+',    label: ['Transactions', 'Since Inception'] },
    { value: '$1.1bn', label: ['Capital Returned', 'to Investors'] },
  ] %}
  {# Optional photo behind the stats, e.g. 'static/img/stats-bg.jpg'. Leave null for the navy gradient. #}
  {% set statsBackground = null %}


  <section class="video-header bg-blue-200 text-white">
    <div class="container">
      <div class="layout-grid gap-y-10 items-center">

        {% if hasContent %}
          <div class="video-header__copy font-serif col-span-full lg:col-span-6">
            {{ headerContent }}
          </div>
        {% endif %}

        <div class="col-span-full {{ hasContent ? 'lg:col-span-6' }}">
          <div
            class="video-header__frame"
            x-data="{
              useVideo: false,
              playing: false,
              init() {
                const conn = navigator.connection || {};
                const slow = conn.saveData || /(^|slow-)2g|3g/.test(conn.effectiveType || '');
                const small = window.matchMedia('(max-width: 767px)').matches;
                const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                if (slow || small || reduced) return;
                this.useVideo = true;
                this.$nextTick(() => {
                  const v = this.$refs.video;
                  if (!v) return;
                  v.muted = true; // must be set as a property for autoplay to be allowed
                  v.play().catch(() => {});
                });
              }
            }"
          >
            {# Static fallback (phones, slow connections, reduced motion, no JS) and loading state #}
            <img src="{{ posterUrl }}" alt="{{ videoLabel }}" width="1280" height="720" fetchpriority="high">

            <template x-if="useVideo">
              <video
                x-ref="video"
                x-bind:class="{ 'is-playing': playing }"
                x-on:playing="playing = true"
                src="{{ videoSrc }}"
                poster="{{ posterUrl }}"
                muted autoplay loop playsinline
                preload="auto"
                disablepictureinpicture
                aria-label="{{ videoLabel }}"
              ></video>
            </template>
          </div>
        </div>

      </div>
    </div>
  </section>

  {% if stats|length %}
    <section class="video-stats" aria-label="BP Capital at a glance">
      {% if statsBackground %}
        <div class="video-stats__bg" aria-hidden="true">
          <img src="{{ url(statsBackground) }}" alt="" loading="lazy">
        </div>
      {% endif %}
      <div class="container">
        <dl class="video-stats__list">
          {% for stat in stats %}
            <div class="video-stats__item">
              <dt class="video-stats__label">
                {% for line in stat.label %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}
              </dt>
              <dd class="video-stats__value">{{ stat.value }}</dd>
            </div>
          {% endfor %}
        </dl>
      </div>
    </section>
  {% endif %}
{% endif %}
