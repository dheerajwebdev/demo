{% import "_macros/image" as _image %}
{% set company = company ?? null %}
{% set position = postion ?? 0 %}

{% if company %}
  {% set additionalLogos = company.additionalLogos.count() ? true : false %}
  {% set logo = company.logo[0] ?? company.logo.one() ?? null %}
  {% set dealStatus = company.dealStatus.one() ?? null %}
  {% set introduction = (company.introduction ?? '')|trim %}

  {# Hover overlay showing the company Introduction. pointer-events:none keeps clicks going to the card links. #}
    {% css %}
      .company-card__intro {
        /* stays inside the card: same size as the card, never taller */
        position: absolute; inset: 0; z-index: 10;
        display: flex; flex-direction: column; gap: 8px;
        padding: 14px 16px; border-radius: inherit;
        background: rgb(0 29 63 / .97); color: #fff; text-align: center;
        overflow-y: auto; overscroll-behavior: contain;
        scrollbar-width: thin; scrollbar-color: rgb(255 255 255 / .35) transparent;
        opacity: 0; visibility: hidden; transform: translateY(6px);
        transition: opacity .3s ease, transform .3s ease, visibility 0s linear .3s;
        pointer-events: none; /* group cards keep their individual logo links clickable */
      }
      /* centre short text vertically; long text starts at the top (safe centering) */
      .company-card__intro > :first-child { margin-top: auto; }
      .company-card__intro > :last-child  { margin-bottom: auto; }
      /* single-link cards: the panel is part of the link, so clicking it still opens the website
         and very long text can be scrolled with the mouse wheel */
      a.company-card .company-card__intro { pointer-events: auto; }

      .company-card:hover .company-card__intro,
      .company-card:focus-within .company-card__intro,
      .company-card:focus-visible .company-card__intro {
        opacity: 1; visibility: visible; transform: none;
        transition: opacity .3s ease, transform .3s ease, visibility 0s;
      }
      .company-card__intro-title { font-family: Castoro, ui-serif, Georgia, serif; font-size: 1.125rem; line-height: 1.2; }
      .company-card__intro-text { margin: 0; font-size: .875rem; line-height: 1.45; }
      .company-card__intro-cta { font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; color: #8fc3ee; }

      /* the round + button would sit on top of the text, so hide it while the panel is open */
      .company-card > .absolute.-bottom-4 { transition: opacity .2s ease; }
      .company-card.has-intro:hover > .absolute.-bottom-4,
      .company-card.has-intro:focus-within > .absolute.-bottom-4 { opacity: 0; }
    {% endcss %}
  {% if additionalLogos %}
  <div class="company-card{{ introduction ? ' has-intro' }} group h-full flex flex-col gap-5 justify-between bg-white py-5 relative min-h-64 rounded-md{% if dealStatus.slug == 'realized' or dealStatus.slug == 'merged' or dealStatus.slug == 'partially-realized' %} border-green-500 border-[5px]{% endif %}">
  {% else %}
  <a
    href="{{ company.websiteLink }}"
    class="company-card{{ introduction ? ' has-intro' }} group h-full flex flex-col gap-5 justify-between bg-white py-5 relative min-h-64 rounded-md{% if dealStatus.slug == 'realized' or dealStatus.slug == 'merged' or dealStatus.slug == 'partially-realized' %} border-green-500 border-[5px]{% endif %}"
    target="_blank"
  >
  {% endif %}
    <div class="pb-5 flex flex-col justify-between h-full">
      {% if company.transactionDate %}
        <h4 class="text-xl text-center pb-3 font-semibold">{{ company.transactionDate|date('F Y') }}</h4>
      {% endif %}
      <div class="flex flex-col justify-between h-full px-5">
        {% if logo %}
          {% if additionalLogos %}<a href="{{ company.websiteLink }}" target="_blank" class="flex flex-col justify-between h-full">{% endif %}
          {{ _image.tag(
            logo,
            company.title,
            { height: 120, quality: 100 },
            "object-contain m-auto",
            logo.extension
          ) }}
          {% if additionalLogos %}</a>{% endif %}
        {% endif %}
      </div>
      {% if additionalLogos %}
        <div class="grid grid-cols-{{ company.additionalLogos.count() }} px-2 items-center">
          {% for block in company.additionalLogos.all() %}
            {% if block.type == 'logos' %}
              <div>
                {% if block.logoText %}
                  <h4 class="text-xl text-center py-3 font-semibold">{{ block.logoText }}</h4>
                {% endif %}
                {% if block.logo.one() %}
                  {% set image = block.logo.one() %}
                  {% set format = block.logo.one().extension %}
                  {# Set default transform options #}
                  {% set transform = [] %}
                  {% set defaultTransform = {
                    quality: 85,
                    format: format,
                    height: 78, 
                    quality: 100
                  } %}

                  {# Merge supplied transform, including dimensions #}
                  {% set transform = defaultTransform|merge(transform) %}

                  {% do image.setTransform(transform) %}
                  {% if block.logoUrl %}<a href="{{ block.logoUrl }}" target="_blank">{% endif %}
                  <img
                    src="{{ image.url }}"
                    alt="{{ image.title }}"
                    width="{{ image.width }}"
                    height="{{ image.height }}"
                    srcset="{{ image.srcset(['1.5x','2x','3x']) }}"
                    class="object-contain mx-auto max-w-40 subsidiary-logo"
                    loading="lazy"
                    data-url="{{ block.logoUrl }}"
                  />
                  {% if block.logoUrl %}</a>{% endif %}
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
      <div>
        {% if company.funds.count() %}<h4 class="text-xl text-center font-bold pt-5">{{ company.funds.one().title }}</h4>{% endif %}
        {% if dealStatus %}
          <h4 class="text-xl text-center italic">{{ dealStatus.title }}{% if (dealStatus.slug == 'realized' or dealStatus.slug == 'merged' or dealStatus.slug == 'partially-realized') and company.mergedRealizedDate %} {{ company.mergedRealizedDate|date('M Y') }}</h4>{% endif %}
        {% endif %}
      </div>
    </div>
    <div class="absolute left-0 right-0 -bottom-4">
      <div class="bg-blue-500 group-hover:bg-blue-300 transition-colors duration-300 flex gap-2 items-center justify-center rounded-full w-9 h-9 mx-auto">
        {{ svg('static/img/icons/plus.svg')|attr({ class: 'h-6 w-6 fill-white'}) }}
      </div>
    </div>
    {% if introduction %}
      <div class="company-card__intro">
        <div class="company-card__intro-title">{{ company.title }}</div>
        <p class="company-card__intro-text">{{ introduction|nl2br }}</p>
        {% if company.websiteLink and not additionalLogos %}
          <span class="company-card__intro-cta">Visit website &rarr;</span>
        {% endif %}
      </div>
    {% endif %}
  {% if additionalLogos %}</div>{% else %}</a>{% endif %}
{% endif %}
