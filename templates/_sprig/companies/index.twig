{% set _eyebrow = _eyebrow ?? null %}
{% set _heading = _heading ?? null %}

{# Filters #}
{% set sector = sector ?? [] %}
{% set theme = theme ?? [] %}
{% set fund = fund ?? [] %}
{% set status = status ?? [] %}
{% set removeFund = removeFund ?? '' %}
{% set removeSector = removeSector ?? '' %}
{% set removeStatus = removeStatus ?? '' %}
{% set removeTheme = removeTheme ?? '' %}

{# Pagination controls #}
{% set limit = 48 %}
{% set page = page ?? 1 %}

{# Basic entry query #}
{% set entryQuery = craft.entries.section('companies').limit(limit) %}

{# Filters #}
{% set funds = craft.entries.section('funds').all() %}
{# {% set sectors = craft.entries.section('sectors').all() %} #}
{% set dealStatus = craft.entries.section('dealStatus').all() %}
{% set themes = craft.entries.section('themes').all() %}

{# Remove any sectors or themes #}
{% if removeFund|length %}
  {% set fund = fund|filter(i => i != removeFund) %}
{% endif %}

{# {% if removeSector|length %}
  {% set sector = sector|filter(i => i != removeSector) %}
{% endif %} #}
{% if removeStatus|length %}
  {% set status = status|filter(i => i != removeStatus) %}
{% endif %}
{% if removeTheme|length %}
  {% set theme = theme|filter(i => i != removeTheme) %}
{% endif %}

{# Build querystring #}
{% set queryString = [] %}
{% if status|length %}
  {% do entryQuery.dealStatus(status) %}
  {% set queryString = queryString|merge(['status=' ~ status|join(',')]) %}
{% endif %}
{# {% if sector|length %}
  {% do entryQuery.sectors(sector) %}
  {% set queryString = queryString|merge(['sector=' ~ sector|join(',')]) %}
{% endif %} #}
{% if theme|length %}
  {% do entryQuery.themes(theme) %}
  {% set queryString = queryString|merge(['theme=' ~ theme|join(',')]) %}
{% endif %}
{% if fund|length %}
  {% do entryQuery.funds(fund) %}
  {% set queryString = queryString|merge(['fund=' ~ fund|join(',')]) %}
{% endif %}

{# Push the querystring onto the URL #}
{% do sprig.pushUrl('?' ~ queryString|join('&')) %}

{% set pageInfo = sprig.paginate(entryQuery, page) %}
{% set entries = pageInfo.pageResults %}

{# Group the companies by Deal Status (in the Deal Status structure's order).
   Realized, Merged and Partially Realized are shown together as one "Realized" group,
   placed where the first of those statuses sits in the order. #}
{% set realizedSlugs = ['realized', 'merged', 'partially-realized'] %}

{% set groupOrder = [] %}
{% set groupTitles = {} %}
{% set groupKeyByStatus = {} %}
{% for statusEntry in dealStatus %}
  {% set key = statusEntry.slug in realizedSlugs ? 'realized' : statusEntry.slug %}
  {% if key not in groupOrder %}
    {% set groupOrder = groupOrder|merge([key]) %}
    {% set groupTitles = groupTitles|merge({ (key): (key == 'realized' ? 'Realized' : statusEntry.title) }) %}
  {% endif %}
  {% set groupKeyByStatus = groupKeyByStatus|merge({ ('s' ~ statusEntry.id): key }) %}
{% endfor %}

{# Which group each company on this page belongs to ('' = no deal status) #}
{% set groupByCompany = {} %}
{% for company in entries %}
  {% set statusId = company.dealStatus.one().id ?? null %}
  {% set groupByCompany = groupByCompany|merge({ ('c' ~ company.id): (statusId ? (groupKeyByStatus['s' ~ statusId] ?? '') : '') }) %}
{% endfor %}

{% set groups = [] %}
{% for key in groupOrder %}
  {% set members = entries|filter(c => groupByCompany['c' ~ c.id] == key) %}
  {% if members|length %}
    {% set groups = groups|merge([{ title: groupTitles[key], slug: key, companies: members }]) %}
  {% endif %}
{% endfor %}
{# Companies without a deal status are still shown, last, without a heading #}
{% set unassigned = entries|filter(c => groupByCompany['c' ~ c.id] == '') %}
{% if unassigned|length %}
  {% set groups = groups|merge([{ title: null, slug: 'other', companies: unassigned }]) %}
{% endif %}

{% macro filter(label, name, filters, var) %}
  <div
    x-data="{ open: false }"
    class="relative w-full md:w-auto"
  >
    <button
      x-on:click="open = !open"
      aria-haspopup="true"
      aria-controls="filter"
      x-bind:aria-expanded="open ? 'true' : 'false'"
      class="w-full group/btn py-2.5 px-5 rounded-full inline-flex relative items-center justify-between gap-4 border text-white border-white"
    >
      Filter by {{ label }}
      {{ svg('static/img/icons/chevron-down.svg')|attr({
        class: 'w-2.5',
        'x-bind:class': "open && 'rotate-180'"
      }) }}
    </button>
    <div
      x-cloak
      x-show="open"
      x-on:click.away="open = false"
      x-bind:aria-hidden="open ? 'false' : 'true'"
      class="absolute mx-auto mt-1 left-0 bg-white p-4 text-blue-200 rounded-lg shadow-lg max-w-none w-full md:w-auto right-auto z-20"
      style="display:none;"
    >
      <ul class="flex flex-col gap-2">
        {% for item in filters %}
          <li>
            <label class="flex gap-2 items-center justify-start font-bold">
              <input sprig
                x-on:click="open = false"
                type="checkbox"
                value="{{ item.id }}"
                name="{{ name }}[]"
                {{ item.id in var ? 'checked' }}
              >
              <div class="lg:whitespace-nowrap">{{ item.title }}</div>
            </label>
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
{% endmacro %}


{% js %}
  /* Give every company card the height of the tallest one (as the old single grid did) */
  (function () {
    function equalise() {
      var items = document.querySelectorAll('.companies-group__grid > article');
      if (!items.length) return;
      var max = 0;
      items.forEach(function (el) { el.style.minHeight = ''; });
      items.forEach(function (el) { max = Math.max(max, el.offsetHeight); });
      items.forEach(function (el) { el.style.minHeight = max + 'px'; });
    }
    var t; function later() { clearTimeout(t); t = setTimeout(equalise, 100); }
    equalise();
    window.addEventListener('load', equalise);
    window.addEventListener('resize', later);
    document.addEventListener('load', function (e) { if (e.target.tagName === 'IMG') later(); }, true); /* lazy logos */
    document.addEventListener('htmx:afterSettle', later); /* Sprig filtering / pagination */
  })();
{% endjs %}
<div class="bg-blue-200 py-16">
  <div class="container">
    <div id="results">
      {% for group in groups %}
        <section class="companies-group" id="{{ group.slug }}" {% if group.title %}aria-labelledby="status-{{ group.slug }}"{% endif %}>
          {% if group.title %}
            <div class="companies-group__head">
              <span class="companies-group__rule" aria-hidden="true"></span>
              <h2 id="status-{{ group.slug }}" class="companies-group__title">{{ group.title }}</h2>
              <span class="companies-group__rule" aria-hidden="true"></span>
            </div>
          {% endif %}
          <div class="companies-group__grid">
            {% for company in group.companies %}
              <article class="flex flex-col pb-7">
                {% include "_components/card/company" with { company } only %}
              </article>
            {% endfor %}
          </div>
        </section>
      {% else %}
        <p class="text-xl italic text-white">
          No results, please try broadening your search.
        </p>
      {% endfor %}
    </div>

    {% include "_sprig/components/pagination" with { pageInfo, textColor: 'text-white' } %}
  </div>
</div>
