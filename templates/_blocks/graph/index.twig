{# Required #}
{% set heading = block.heading %} {# Plain Text #}
{% set text = block.body %} {# Plain Text #}

{# Optional #}
{% set eyebrow = block.eyebrow ?? '' %} {# Plain Text #}
{% set linkField = block.linkField ?? null %} {# Hyper #}
{% set linkField2 = block.linkField2 ?? null %} {# Hyper #}
{% set graph = block.graph ?? [] %} {# Table #}
{% set eyebrowLink = block.eyebrowLink ?? null %} {# Hyper #}

{% macro bar(height, bgColor, textColor, padding, number, detail) %}
  <div
    class="{{ bgColor }} {{ textColor }} {{ padding }} w-1/3 px-2 flex flex-col gap-2"
    style="min-height: {{ height }};"
  >
    <p class="font-serif text-4xl lg:text-5xl xl:text-[64px] leading-none text-center">
      {{ number }}
    </p>
    <p class="text-center text-sm sm:text-base xl:text-xl">
      {{ detail }}
    </p>
  </div>
{% endmacro %}
<section class="bg-white py-24">
  <div class=" container">
    <div class="layout-grid items-center">
      <div class="col-span-full lg:col-span-5 flex flex-col items-start gap-[18px]">
        {% if eyebrow and eyebrowLink %}
          <a {% if eyebrowLink.url %}href="{{ eyebrowLink.url }}"{% endif %} class="t-eyebrow">{{ eyebrow }}</a>
        {% elseif eyebrow %}
          <div class="t-eyebrow">{{ eyebrow }}</div>
        {% endif %}
        {% if heading %}
          <h2 class="t-h2">{{ heading }}</h2>
        {% endif %}
        {{ text }}
      </div>

      <div class="col-span-full lg:col-start-7 lg:col-span-6 flex items-end justify-end">
        {% if graph[0] %}
          {{ _self.bar('98px', 'bg-blue-200', 'text-white', 'pb-8 lg:pb-10 pt-8', graph[0].number, graph[0].detail) }}
        {% endif %}
        {% if graph[1] %}
          {{ _self.bar('206px', 'bg-blue-300', 'text-white', 'pb-8 lg:pb-20 pt-10', graph[1].number, graph[1].detail) }}
        {% endif %}
        {% if graph[2] %}
          {{ _self.bar('298px', 'bg-blue-700', 'text-blue-200', 'pb-8 lg:pb-20 pt-8', graph[2].number, graph[2].detail) }}
        {% endif %}
      </div>
    </div>
    {% if linkField or linkField2 %}
      {% css %}
        .graph-buttons {
          display: flex; flex-wrap: wrap; align-items: center; justify-content: center;
          gap: 16px 24px; margin-top: 40px;
        }
        @media (min-width: 1024px) { .graph-buttons { gap: 16px 32px; margin-top: 48px; } }

        /* Second button: theme blue */
        .graph-buttons .btn-theme {
          background-color: #2C82E9; border-color: #2C82E9; color: #fff;
          transition: background-color .2s ease, border-color .2s ease;
        }
        .graph-buttons .btn-theme svg { fill: #fff; color: #2C82E9; }
        .graph-buttons .btn-theme:hover,
        .graph-buttons .btn-theme:focus-visible { background-color: #001D3F; border-color: #001D3F; }
        .graph-buttons .btn-theme:hover svg,
        .graph-buttons .btn-theme:focus-visible svg { fill: #fff; color: #001D3F; }
      {% endcss %}

      <div class="graph-buttons">
        {% if linkField %}
          {% include "_components/button" with {
            href: linkField.url,
            label: linkField.text,
            arrow: 'right',
          } %}
        {% endif %}
        {% if linkField2 %}
          {% include "_components/button" with {
            href: linkField2.url,
            label: linkField2.text,
            arrow: 'right',
            color: 'white',
            adClass: 'btn-theme'
          } %}
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>
